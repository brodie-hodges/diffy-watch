#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'EOF'
Usage: diffy-watch [sbs] [-n SECONDS] [-d DIRECTORY ...] [-- DIFF_ARGS...]

Refreshes a tmux-friendly diff view for one or more Git worktrees.

While running:
  r          manual refresh
  s          side by side diffs
  i          inline diffs
  n          toggle line numbers
  /          set file filter
  c          clear file filter
  + / -      increase/decrease context lines
  f / d      files/status only
  j / k      next/previous changed file
  space      collapse/expand selected file diff
  E          expand all file diffs
  C          collapse all file diffs
  [ / ]      previous/next repository
  l          launch lazygit for the active repository

Examples:
  diffy-watch
  diffy-watch sbs
  diffy-watch -n 1 -d ~/Workspace/project-a -d ~/Workspace/project-b
  diffy-watch -d . -- packages/foo/src/file.ts
EOF
}

mode="inline"
last_diff_mode="inline"
show_line_numbers="on"
file_filter=""
context_lines="3"
interval="2"
diff_args=()
diff_args_present=0
requested_directories=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    sbs|--sbs)
      mode="sbs"
      shift
      ;;
    -n|--interval)
      interval="${2:-}"
      if [ -z "$interval" ] || case "$interval" in *[!0-9]*) true ;; *) false ;; esac; then
        echo "diffy-watch: interval must be a whole number of seconds" >&2
        exit 2
      fi
      shift 2
      ;;
    -d|--directory)
      if [ "$#" -lt 2 ] || [ -z "${2:-}" ]; then
        echo "diffy-watch: missing directory value" >&2
        exit 2
      fi
      requested_directories+=("$2")
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      diff_args=("$@")
      diff_args_present=1
      break
      ;;
    -* )
      echo "diffy-watch: unknown option: $1" >&2
      echo "Try 'diffy-watch --help' for usage." >&2
      exit 2
      ;;
    *)
      requested_directories+=("$1")
      shift
      ;;
  esac
done

if [ "${#requested_directories[@]}" -eq 0 ]; then
  requested_directories=(".")
fi

repo_roots=()
repo_temp_dirs=()
repo_temp_indexes=()
repo_statuses=()
repo_errors=()
repo_operations=()
active_repo=0

file_paths=()
file_repos=()
file_keys=()
selected_file=0
selected_file_key=""
collapsed_keys=()

repo_git() {
  local repo_index="$1"
  shift
  GIT_INDEX_FILE="${repo_temp_indexes[$repo_index]}" \
    git -C "${repo_roots[$repo_index]}" "$@"
}

repo_status() {
  local repo_index="$1"

  if [ "$diff_args_present" -eq 1 ] && [ "${#diff_args[@]}" -gt 0 ]; then
    repo_git "$repo_index" status --short -uall -- "${diff_args[@]}"
  else
    repo_git "$repo_index" status --short -uall
  fi
}

repo_diff_all() {
  local repo_index="$1"
  shift

  if [ "$diff_args_present" -eq 1 ] && [ "${#diff_args[@]}" -gt 0 ]; then
    repo_git "$repo_index" "$@" -- "${diff_args[@]}"
  else
    repo_git "$repo_index" "$@"
  fi
}

git_path_for_repo() {
  local repo_index="$1"
  local git_path=""

  git_path="$(git -C "${repo_roots[$repo_index]}" rev-parse --git-path "$2" 2>/dev/null)" || return 1
  case "$git_path" in
    /*)
      printf '%s\n' "$git_path"
      ;;
    *)
      printf '%s/%s\n' "${repo_roots[$repo_index]}" "$git_path"
      ;;
  esac
}

register_repo() {
  local requested="$1"
  local root=""
  local existing=""
  local temp_dir=""

  if ! root="$(git -C "$requested" rev-parse --show-toplevel 2>/dev/null)"; then
    echo "diffy-watch: not inside a Git worktree: $requested" >&2
    return 0
  fi

  if [ "${#repo_roots[@]}" -gt 0 ]; then
    for existing in "${repo_roots[@]}"; do
      if [ "$existing" = "$root" ]; then
        return 0
      fi
    done
  fi

  temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/diffy-watch.XXXXXX")"
  repo_roots+=("$root")
  repo_temp_dirs+=("$temp_dir")
  repo_temp_indexes+=("$temp_dir/index")
  repo_statuses+=("")
  repo_errors+=("")
  repo_operations+=("")
}

for requested_directory in "${requested_directories[@]}"; do
  register_repo "$requested_directory"
done

if [ "${#repo_roots[@]}" -eq 0 ]; then
  exit 1
fi

cleanup() {
  local temp_dir=""

  if [ "${#repo_temp_dirs[@]}" -gt 0 ]; then
    for temp_dir in "${repo_temp_dirs[@]}"; do
      rm -f "$temp_dir/index"
      rmdir "$temp_dir" 2>/dev/null || true
    done
  fi
}

restore_tmux_focus() {
  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
    tmux select-pane -t "$TMUX_PANE" >/dev/null 2>&1 || true
  fi
}

crash_line=""
crash_command=""

on_exit() {
  local exit_code="$1"

  cleanup
  restore_tmux_focus

  if [ "$exit_code" -ne 0 ] && [ -n "$crash_command" ]; then
    printf 'diffy-watch: exited %s at line %s: %s\n' \
      "$exit_code" "$crash_line" "$crash_command" >&2
  fi
}

on_error() {
  crash_line="$1"
  crash_command="$2"
}

trap 'on_error "$LINENO" "$BASH_COMMAND"' ERR
trap 'on_exit "$?"' EXIT

copy_repo_index() {
  local repo_index="$1"
  local index_path=""

  index_path="$(git_path_for_repo "$repo_index" index)" || return 1
  if [ -f "$index_path" ]; then
    cp "$index_path" "${repo_temp_indexes[$repo_index]}" 2>/dev/null
  else
    rm -f "${repo_temp_indexes[$repo_index]}"
    repo_git "$repo_index" read-tree --empty >/dev/null 2>&1
  fi
}

repo_operation() {
  local repo_index="$1"
  local operation=""
  local operation_path=""

  operation_path="$(git_path_for_repo "$repo_index" rebase-merge)" || operation_path=""
  if [ -d "$operation_path" ]; then
    printf 'REBASE (interactive)'
    return 0
  fi

  operation_path="$(git_path_for_repo "$repo_index" rebase-apply)" || operation_path=""
  if [ -d "$operation_path" ]; then
    printf 'REBASE'
    return 0
  fi

  operation_path="$(git_path_for_repo "$repo_index" MERGE_HEAD)" || operation_path=""
  if [ -f "$operation_path" ]; then
    printf 'MERGE'
    return 0
  fi

  operation_path="$(git_path_for_repo "$repo_index" CHERRY_PICK_HEAD)" || operation_path=""
  if [ -f "$operation_path" ]; then
    printf 'CHERRY-PICK'
    return 0
  fi

  operation_path="$(git_path_for_repo "$repo_index" REVERT_HEAD)" || operation_path=""
  if [ -f "$operation_path" ]; then
    printf 'REVERT'
    return 0
  fi

  operation_path="$(git_path_for_repo "$repo_index" BISECT_HEAD)" || operation_path=""
  if [ -f "$operation_path" ]; then
    printf 'BISECT'
    return 0
  fi

  printf 'NORMAL'
}

count_conflicts() {
  local status_text="$1"
  local status_line=""
  local conflict_count=0

  while IFS= read -r status_line; do
    case "$status_line" in
      UU*|AA*|DD*|AU*|UA*|DU*|UD*)
        conflict_count=$((conflict_count + 1))
        ;;
    esac
  done <<< "$status_text"

  printf '%s\n' "$conflict_count"
}

refresh_repo_state() {
  local repo_index="$1"
  local status_text=""
  local status_exit=0
  local conflict_count=0
  local operation=""

  repo_errors[$repo_index]=""
  if ! copy_repo_index "$repo_index"; then
    repo_errors[$repo_index]="unable to copy the Git index"
    repo_statuses[$repo_index]=""
    repo_operations[$repo_index]="$(repo_operation "$repo_index")"
    return 0
  fi

  repo_git "$repo_index" add -N . >/dev/null 2>&1 || true
  status_text="$(repo_status "$repo_index" 2>&1)" || status_exit=$?
  repo_statuses[$repo_index]="$status_text"
  operation="$(repo_operation "$repo_index")"
  conflict_count="$(count_conflicts "$status_text")"

  if [ "$status_exit" -ne 0 ]; then
    repo_errors[$repo_index]="$status_text"
  elif [ "$conflict_count" -gt 0 ]; then
    repo_operations[$repo_index]="$operation, $conflict_count conflict(s)"
  else
    repo_operations[$repo_index]="$operation"
  fi
}

file_key() {
  printf '%s|%s' "${repo_roots[$1]}" "$2"
}

key_is_collapsed() {
  local wanted="$1"
  local key=""

  if [ "${#collapsed_keys[@]}" -gt 0 ]; then
    for key in "${collapsed_keys[@]}"; do
      if [ "$key" = "$wanted" ]; then
        return 0
      fi
    done
  fi
  return 1
}

path_matches_filter() {
  local repo_index="$1"
  local path="$2"

  if [ -z "$file_filter" ]; then
    return 0
  fi

  case "$path" in
    *"$file_filter"*)
      return 0
      ;;
  esac

  if [ -f "${repo_roots[$repo_index]}/$path" ] && \
    grep -I -F -q -- "$file_filter" "${repo_roots[$repo_index]}/$path"; then
    return 0
  fi

  if repo_git "$repo_index" --no-pager diff --color=never --staged -- "$path" 2>/dev/null | \
    grep -F -q -- "$file_filter"; then
    return 0
  fi

  if repo_git "$repo_index" --no-pager diff --color=never -- "$path" 2>/dev/null | \
    grep -F -q -- "$file_filter"; then
    return 0
  fi

  return 1
}

append_file_if_new() {
  local repo_index="$1"
  local path="$2"
  local existing_repo=""
  local existing_path=""

  if ! path_matches_filter "$repo_index" "$path"; then
    return 0
  fi

  if [ "${#file_paths[@]}" -gt 0 ]; then
    for existing_file_index in "${!file_paths[@]}"; do
      existing_repo="${file_repos[$existing_file_index]}"
      existing_path="${file_paths[$existing_file_index]}"
      if [ "$existing_repo" -eq "$repo_index" ] && [ "$existing_path" = "$path" ]; then
        return 0
      fi
    done
  fi

  file_paths+=("$path")
  file_repos+=("$repo_index")
  file_keys+=("$(file_key "$repo_index" "$path")")
}

refresh_file_index() {
  local previous_selected_key="$selected_file_key"
  local repo_index=0
  local status_line=""
  local path=""
  local current_key=""
  local collapsed_key=""
  local found=0

  file_paths=()
  file_repos=()
  file_keys=()

  for repo_index in "${!repo_roots[@]}"; do
    while IFS= read -r status_line; do
      [ -n "$status_line" ] || continue
      path="${status_line:3}"
      case "$path" in
        *' -> '*)
          path="${path##* -> }"
          ;;
      esac
      append_file_if_new "$repo_index" "$path"
    done <<< "${repo_statuses[$repo_index]}"
  done

  if [ "${#collapsed_keys[@]}" -gt 0 ]; then
    for collapsed_key_index in "${!collapsed_keys[@]}"; do
      collapsed_key="${collapsed_keys[$collapsed_key_index]}"
      found=0
      if [ "${#file_keys[@]}" -gt 0 ]; then
        for current_key in "${file_keys[@]}"; do
          if [ "$collapsed_key" = "$current_key" ]; then
            found=1
            break
          fi
        done
      fi
      if [ "$found" -eq 0 ]; then
        unset 'collapsed_keys[$collapsed_key_index]'
      fi
    done
  fi

  if [ "${#file_keys[@]}" -eq 0 ]; then
    selected_file=0
    selected_file_key=""
    return 0
  fi

  selected_file=0
  selected_file_key="${file_keys[0]}"
  for file_index in "${!file_keys[@]}"; do
    if [ "${file_keys[$file_index]}" = "$previous_selected_key" ]; then
      selected_file="$file_index"
      selected_file_key="$previous_selected_key"
      break
    fi
  done
}

prepare_state() {
  local repo_index=0

  for repo_index in "${!repo_roots[@]}"; do
    refresh_repo_state "$repo_index"
  done
  refresh_file_index
}

set_active_repo_for_file() {
  if [ "${#file_repos[@]}" -gt 0 ]; then
    active_repo="${file_repos[$selected_file]}"
  fi
}

move_file_selection() {
  local direction="$1"
  local file_count="${#file_paths[@]}"

  [ "$file_count" -gt 0 ] || return 0
  if [ "$direction" = "next" ]; then
    selected_file=$((selected_file + 1))
    if [ "$selected_file" -ge "$file_count" ]; then
      selected_file=0
    fi
  else
    selected_file=$((selected_file - 1))
    if [ "$selected_file" -lt 0 ]; then
      selected_file=$((file_count - 1))
    fi
  fi
  selected_file_key="${file_keys[$selected_file]}"
  set_active_repo_for_file
}

move_repo_selection() {
  local direction="$1"
  local repo_count="${#repo_roots[@]}"
  local file_index=0

  if [ "$direction" = "next" ]; then
    active_repo=$((active_repo + 1))
    if [ "$active_repo" -ge "$repo_count" ]; then
      active_repo=0
    fi
  else
    active_repo=$((active_repo - 1))
    if [ "$active_repo" -lt 0 ]; then
      active_repo=$((repo_count - 1))
    fi
  fi

  if [ "${#file_repos[@]}" -gt 0 ]; then
    for file_index in "${!file_repos[@]}"; do
      if [ "${file_repos[$file_index]}" -eq "$active_repo" ]; then
        selected_file="$file_index"
        selected_file_key="${file_keys[$file_index]}"
        return 0
      fi
    done
  fi
}

toggle_selected_file() {
  local selected_key=""
  local retained_keys=()
  local key=""

  [ "${#file_keys[@]}" -gt 0 ] || return 0
  selected_key="${file_keys[$selected_file]}"
  if key_is_collapsed "$selected_key"; then
    if [ "${#collapsed_keys[@]}" -gt 0 ]; then
      for key in "${collapsed_keys[@]}"; do
        [ "$key" = "$selected_key" ] || retained_keys+=("$key")
      done
    fi
    collapsed_keys=()
    if [ "${#retained_keys[@]}" -gt 0 ]; then
      for key in "${retained_keys[@]}"; do
        collapsed_keys+=("$key")
      done
    fi
  else
    collapsed_keys+=("$selected_key")
  fi
}

set_all_collapsed() {
  local collapse="$1"
  local key=""

  collapsed_keys=()
  if [ "$collapse" = "yes" ]; then
    if [ "${#file_keys[@]}" -gt 0 ]; then
      for key in "${file_keys[@]}"; do
        collapsed_keys+=("$key")
      done
    fi
  fi
}

clear_screen() {
  clear 2>/dev/null || printf '\033[H\033[2J'
}

pill() {
  local fg="$1"
  local bg="$2"
  local text="$3"

  printf '\033[38;5;%sm\033[38;5;%s;48;5;%sm %s \033[0m\033[38;5;%sm\033[0m' \
    "$bg" "$fg" "$bg" "$text" "$bg"
}

key_hint() {
  local key="$1"
  local label="$2"

  printf '\033[38;5;244m[\033[38;5;255m%s\033[38;5;244m] \033[0m\033[38;5;252m%s\033[0m' \
    "$key" "$label"
}

section_header() {
  local fg="$1"
  local bg="$2"
  local label="$3"

  printf '\n'
  pill "$fg" "$bg" "$label"
  printf '\n'
}

repo_has_file() {
  local repo_index="$1"
  local file_index="0"

  if [ "${#file_repos[@]}" -gt 0 ]; then
    for file_index in "${!file_repos[@]}"; do
      if [ "${file_repos[$file_index]}" -eq "$repo_index" ]; then
        return 0
      fi
    done
  fi
  return 1
}

print_file_label() {
  local file_index="$1"
  local marker=" "
  local state="expanded"

  if [ "$file_index" -eq "$selected_file" ]; then
    marker='>'
  fi
  if key_is_collapsed "${file_keys[$file_index]}"; then
    state="collapsed"
  fi
  printf '\033[38;5;111m%s [%s] %s\033[0m\n' \
    "$marker" "$state" "${file_paths[$file_index]}"
}

render_file_diff() {
  local repo_index="$1"
  local path="$2"
  local staged="$3"

  if [ "$staged" = "yes" ]; then
    repo_git "$repo_index" --no-pager diff --color=always --staged "${context_args[@]}" -- "$path" 2>/dev/null | \
      delta "${delta_args[@]}" || true
  else
    repo_git "$repo_index" --no-pager diff --color=always "${context_args[@]}" -- "$path" 2>/dev/null | \
      delta "${delta_args[@]}" || true
  fi
}

render_repo() {
  local repo_index="$1"
  local file_index=0
  local active_label=""
  local status_text="${repo_statuses[$repo_index]}"

  active_label=" "
  if [ "$repo_index" -eq "$active_repo" ]; then
    active_label=" *ACTIVE*"
  fi
  section_header 15 39 "REPOSITORY $((repo_index + 1))/${#repo_roots[@]}$active_label"
  printf '\033[38;5;111m%s\033[0m\n' "${repo_roots[$repo_index]}"
  printf '\033[38;5;244mOperation\033[0m  %s\n' "${repo_operations[$repo_index]}"
  if [ -n "${repo_errors[$repo_index]}" ]; then
    printf '\033[38;5;196mGit error\033[0m   %s\n' "${repo_errors[$repo_index]}"
  fi

  section_header 15 39 "STATUS"
  if [ -n "$status_text" ]; then
    printf '%s\n' "$status_text"
  else
    printf '(clean)\n'
  fi

  [ "$mode" != "status" ] || return 0
  if ! repo_has_file "$repo_index"; then
    return 0
  fi

  section_header 15 28 "DIFFS"
  for file_index in "${!file_paths[@]}"; do
    [ "${file_repos[$file_index]}" -eq "$repo_index" ] || continue
    print_file_label "$file_index"
    if key_is_collapsed "${file_keys[$file_index]}"; then
      printf '  (diff collapsed; press space to expand)\n'
      continue
    fi
    printf '\033[38;5;244m  STAGED\033[0m\n'
    render_file_diff "$repo_index" "${file_paths[$file_index]}" yes
    printf '\033[38;5;244m  UNSTAGED + UNTRACKED\033[0m\n'
    render_file_diff "$repo_index" "${file_paths[$file_index]}" no
  done
}

render() {
  local repo_index=0

  prepare_state
  context_args=(-U"$context_lines")
  delta_args=(
    --paging=never
    --plus-style="syntax 22"
    --plus-emph-style="syntax 28"
    --plus-empty-line-marker-style="normal 22"
    --minus-style="normal 52"
    --minus-emph-style="normal 124"
    --minus-empty-line-marker-style="normal 52"
  )
  if [ "$show_line_numbers" = "on" ]; then
    delta_args+=(--line-numbers)
  fi
  if [ "$mode" = "sbs" ]; then
    delta_args+=(--side-by-side)
  fi

  clear_screen
  case "$mode" in
    sbs) mode_label="sbs" ;;
    status) mode_label="status" ;;
    *) mode_label="inline" ;;
  esac

  pill 15 39 "⚡👀 diffy-watch"
  printf '  '
  pill 15 60 "$mode_label"
  printf '  \033[38;5;111m%s\033[0m\n' "$(date '+%Y-%m-%d %H:%M:%S')"

  printf '\033[38;5;244mControls\033[0m  '
  key_hint 'r' 'refresh'
  printf '  '
  key_hint 's/i' 'diff mode'
  printf '  '
  key_hint 'n' 'line nums'
  printf '  '
  key_hint '/' 'filter'
  printf '  '
  key_hint '+/-' 'context'
  printf '  '
  key_hint 'j/k' 'files'
  printf '  '
  key_hint 'space' 'collapse'
  printf '  '
  key_hint '[/]' 'repos'
  printf '  '
  key_hint 'l' 'lazygit'
  printf '\n'
  printf '\033[38;5;244mContext\033[0m   \033[38;5;255m%s lines\033[0m\n' "$context_lines"
  printf '\033[38;5;244mActive repo\033[0m \033[38;5;255m%s\033[0m\n' "${repo_roots[$active_repo]}"
  if [ -n "$file_filter" ]; then
    printf '\033[38;5;244mFilter\033[0m    \033[38;5;255m%s\033[0m\n' "$file_filter"
  fi

  for repo_index in "${!repo_roots[@]}"; do
    render_repo "$repo_index"
  done
}

launch_lazygit() {
  clear_screen
  if ! command -v lazygit >/dev/null 2>&1; then
    printf 'diffy-watch: lazygit is not installed\n' >&2
    return 0
  fi
  (
    cd "${repo_roots[$active_repo]}"
    command lazygit
  )
}

drain_escape_sequence() {
  local byte=""

  while IFS= read -rsn1 -t 0.01 byte; do
    case "$byte" in
      [A-Za-z~])
        break
        ;;
    esac
  done
}

prompt_file_filter() {
  local input=""
  local rows=""

  rows="$(tput lines 2>/dev/null || printf '24')"
  printf '\0337'
  printf '\033[%s;1H\033[0Kfile filter (blank clears): ' "$rows"
  if ! IFS= read -r input; then
    printf '\0338'
    return 1
  fi
  printf '\0338'
  file_filter="$input"
}

last_signature=""
resize_pending=0
force_render=1

trap 'resize_pending=1' WINCH

while true; do
  key=""
  if [ "$resize_pending" -eq 1 ]; then
    force_render=1
    resize_pending=0
    restore_tmux_focus
  fi

  if IFS= read -rsn1 -t "$interval" key; then
    if [ "$key" = $'\e' ]; then
      drain_escape_sequence
      continue
    fi
    case "$key" in
      r)
        force_render=1
        ;;
      s)
        if [ "$mode" = "sbs" ]; then
          mode="inline"
        else
          last_diff_mode="$mode"
          mode="sbs"
        fi
        if [ "$mode" != "status" ]; then
          last_diff_mode="$mode"
        fi
        force_render=1
        ;;
      i)
        if [ "$mode" = "inline" ]; then
          mode="sbs"
        else
          last_diff_mode="$mode"
          mode="inline"
        fi
        if [ "$mode" != "status" ]; then
          last_diff_mode="$mode"
        fi
        force_render=1
        ;;
      n)
        if [ "$show_line_numbers" = "on" ]; then
          show_line_numbers="off"
        else
          show_line_numbers="on"
        fi
        force_render=1
        ;;
      /)
        if prompt_file_filter; then
          force_render=1
        fi
        ;;
      c)
        file_filter=""
        force_render=1
        ;;
      +|=)
        context_lines=$((context_lines + 1))
        force_render=1
        ;;
      -)
        if [ "$context_lines" -gt 0 ]; then
          context_lines=$((context_lines - 1))
        fi
        force_render=1
        ;;
      f|d)
        if [ "$mode" = "status" ]; then
          mode="$last_diff_mode"
        else
          last_diff_mode="$mode"
          mode="status"
        fi
        force_render=1
        ;;
      j)
        move_file_selection next
        force_render=1
        ;;
      k)
        move_file_selection previous
        force_render=1
        ;;
      ' ')
        toggle_selected_file
        force_render=1
        ;;
      E)
        set_all_collapsed no
        force_render=1
        ;;
      C)
        set_all_collapsed yes
        force_render=1
        ;;
      '[')
        move_repo_selection previous
        force_render=1
        ;;
      ']')
        move_repo_selection next
        force_render=1
        ;;
      l)
        launch_lazygit
        force_render=1
        ;;
    esac
  fi

  signature="$(
    for repo_index in "${!repo_roots[@]}"; do
      copy_repo_index "$repo_index" || printf 'index-copy-failed:%s\n' "$repo_index"
      repo_git "$repo_index" add -N . >/dev/null 2>&1 || true
      printf 'repo:%s\n' "${repo_roots[$repo_index]}"
      repo_status "$repo_index" 2>&1 || true
      repo_diff_all "$repo_index" diff --staged --binary 2>&1 || true
      repo_diff_all "$repo_index" diff --binary 2>&1 || true
      repo_operation "$repo_index"
      printf '\n'
    done | git -C "${repo_roots[0]}" hash-object --stdin
  )"
  if [ "$signature" != "$last_signature" ] || [ "$force_render" -eq 1 ]; then
    render
    last_signature="$signature"
    force_render=0
  fi
done
