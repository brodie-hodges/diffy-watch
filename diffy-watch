#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'EOF'
Usage: diffy-watch [sbs] [-n SECONDS] [DIRECTORY] [-- DIFF_ARGS...]

Refreshes a tmux-friendly diff view when staged, unstaged, or untracked
changes in a Git worktree change.

While running:
  r          manual refresh
  s          side by side diffs
  i          inline diffs
  n          toggle line numbers
  /          search files and diffs
  c          clear search
  u          toggle untracked files
  a          toggle added files
  m          toggle modified files
  + / -      increase/decrease context lines
  up / down  page selected diff backward/forward
  j / k      select next/previous status row
  left/right select previous/next status row
  q          quit
  l          launch lazygit

Examples:
  diffy-watch
  diffy-watch sbs
  diffy-watch -n 1 ~/Workspace/project
  diffy-watch sbs . -- packages/foo/src/file.ts
EOF
}

mode="inline"
show_line_numbers="on"
search_term=""
show_untracked="on"
show_added="on"
show_modified="on"
context_lines="3"
interval="2"
directory="."
directory_set=0
diff_args=()
diff_args_present=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    sbs|--sbs)
      mode="sbs"
      shift
      ;;
    -n|--interval)
      interval="${2:-}"
      if [ -z "$interval" ] || case "$interval" in *[!0-9]*) true ;; *) false ;; esac; then
        echo "diffy-watch: interval must be a whole number of seconds" >&2
        exit 2
      fi
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      diff_args=("$@")
      diff_args_present=1
      break
      ;;
    -* )
      echo "diffy-watch: unknown option: $1" >&2
      echo "Try 'diffy-watch --help' for usage." >&2
      exit 2
      ;;
    *)
      if [ "$directory_set" -eq 1 ]; then
        echo "diffy-watch: only one directory can be watched per instance" >&2
        exit 2
      fi
      directory="$1"
      directory_set=1
      shift
      ;;
  esac
done

cd "$directory"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "diffy-watch: not inside a Git worktree: $directory" >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/diffy-watch.XXXXXX")"
temp_index="$temp_dir/index"
crash_line=""
crash_command=""

file_paths=()
file_statuses=()
file_keys=()
selected_row=0
selected_key="__all__"
repo_status_text=""
repo_error=""
repo_operation="NORMAL"
screen_lines=()
screen_click_rows=()
diff_lines=()
diff_viewport_top=0
diff_page_size=1
status_window_top=0
terminal_rows=24
tui_active=0
terminal_stty_state=""
diff_dirty=1

git_temp() {
  GIT_INDEX_FILE="$temp_index" git "$@"
}

git_path() {
  local path=""

  path="$(git rev-parse --git-path "$1" 2>/dev/null)" || return 1
  case "$path" in
    /*)
      printf '%s\n' "$path"
      ;;
    *)
      printf '%s/%s\n' "$repo_root" "$path"
      ;;
  esac
}

copy_index() {
  local index_path=""

  index_path="$(git_path index)" || return 1
  if [ -f "$index_path" ]; then
    cp "$index_path" "$temp_index" 2>/dev/null
  else
    rm -f "$temp_index"
    git_temp read-tree --empty >/dev/null 2>&1
  fi
}

cleanup() {
  rm -f "$temp_index"
  rmdir "$temp_dir" 2>/dev/null || true
}

enter_tui() {
  tui_active=1
  terminal_stty_state=""
  if [ -t 0 ]; then
    terminal_stty_state="$(stty -g 2>/dev/null)" || terminal_stty_state=""
    stty -echo 2>/dev/null || true
  fi
  printf '\033[?1049h\033[?25l\033[?7l\033[?1000h\033[?1006h\033[2J\033[H'
}

leave_tui() {
  if [ "$tui_active" -eq 1 ]; then
    printf '\033[?1006l\033[?1000l\033[?7h\033[?25h\033[?1049l'
    if [ -n "$terminal_stty_state" ]; then
      stty "$terminal_stty_state" 2>/dev/null || true
      terminal_stty_state=""
    fi
    tui_active=0
  fi
}

restore_tmux_focus() {
  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
    tmux select-pane -t "$TMUX_PANE" >/dev/null 2>&1 || true
  fi
}

terminal_row_count() {
  local size=""
  local rows=""

  if [ -t 0 ]; then
    size="$(stty size 2>/dev/null)" || size=""
    rows="${size%% *}"
    case "$rows" in
      ''|*[!0-9]*) ;;
      *)
        if [ "$rows" -gt 0 ]; then
          printf '%s\n' "$rows"
          return 0
        fi
        ;;
    esac
  fi
  rows="$(tput lines 2>/dev/null || printf '24')"
  case "$rows" in
    ''|*[!0-9]*) rows=24 ;;
  esac
  [ "$rows" -gt 0 ] || rows=24
  printf '%s\n' "$rows"
}

on_exit() {
  local exit_code="$1"

  leave_tui
  cleanup
  restore_tmux_focus

  if [ "$exit_code" -ne 0 ] && [ -n "$crash_command" ]; then
    printf 'diffy-watch: exited %s at line %s: %s\n' \
      "$exit_code" "$crash_line" "$crash_command" >&2
  fi
}

on_error() {
  crash_line="$1"
  crash_command="$2"
}

trap 'on_error "$LINENO" "$BASH_COMMAND"' ERR
trap 'on_exit "$?"' EXIT

repo_status() {
  if [ "$diff_args_present" -eq 1 ] && [ "${#diff_args[@]}" -gt 0 ]; then
    git_temp status --short -uall -- "${diff_args[@]}"
  else
    git_temp status --short -uall
  fi
}

repo_status_actual() {
  if [ "$diff_args_present" -eq 1 ] && [ "${#diff_args[@]}" -gt 0 ]; then
    git status --short -uall -- "${diff_args[@]}"
  else
    git status --short -uall
  fi
}

repo_diff() {
  local diff_command="$1"
  shift

  if [ "$diff_args_present" -eq 1 ] && [ "${#diff_args[@]}" -gt 0 ]; then
    git_temp "$diff_command" "$@" -- "${diff_args[@]}"
  else
    git_temp "$diff_command" "$@"
  fi
}

detect_operation() {
  local operation_path=""

  operation_path="$(git_path rebase-merge)" || operation_path=""
  if [ -d "$operation_path" ]; then
    printf 'REBASE (interactive)'
    return 0
  fi

  operation_path="$(git_path rebase-apply)" || operation_path=""
  if [ -d "$operation_path" ]; then
    printf 'REBASE'
    return 0
  fi

  operation_path="$(git_path MERGE_HEAD)" || operation_path=""
  if [ -f "$operation_path" ]; then
    printf 'MERGE'
    return 0
  fi

  operation_path="$(git_path CHERRY_PICK_HEAD)" || operation_path=""
  if [ -f "$operation_path" ]; then
    printf 'CHERRY-PICK'
    return 0
  fi

  operation_path="$(git_path REVERT_HEAD)" || operation_path=""
  if [ -f "$operation_path" ]; then
    printf 'REVERT'
    return 0
  fi

  operation_path="$(git_path BISECT_HEAD)" || operation_path=""
  if [ -f "$operation_path" ]; then
    printf 'BISECT'
    return 0
  fi

  printf 'NORMAL'
}

count_conflicts() {
  local status_text="$1"
  local status_line=""
  local conflict_count=0

  while IFS= read -r status_line; do
    case "$status_line" in
      UU*|AA*|DD*|AU*|UA*|DU*|UD*)
        conflict_count=$((conflict_count + 1))
        ;;
    esac
  done <<< "$status_text"

  printf '%s\n' "$conflict_count"
}

path_matches_search() {
  local path="$1"

  if [ -z "$search_term" ]; then
    return 0
  fi

  case "$path" in
    *"$search_term"*)
      return 0
      ;;
  esac

  if [ -f "$repo_root/$path" ] && grep -I -F -q -- "$search_term" "$repo_root/$path"; then
    return 0
  fi

  if git_temp --no-pager diff --color=never --staged -- "$path" 2>/dev/null | \
    grep -F -q -- "$search_term"; then
    return 0
  fi

  if git_temp --no-pager diff --color=never -- "$path" 2>/dev/null | \
    grep -F -q -- "$search_term"; then
    return 0
  fi

  return 1
}

status_is_visible() {
  local status="$1"

  if [ "$status" = "??" ]; then
    [ "$show_untracked" = "on" ]
  elif [ "${status:0:1}" = "A" ] || [ "${status:1:1}" = "A" ]; then
    [ "$show_added" = "on" ]
  else
    [ "$show_modified" = "on" ]
  fi
}

status_filters_active() {
  [ "$show_untracked" != "on" ] || \
    [ "$show_added" != "on" ] || \
    [ "$show_modified" != "on" ]
}

append_file_if_new() {
  local status="$1"
  local path="$2"

  if ! status_is_visible "$status"; then
    return 0
  fi
  if ! path_matches_search "$path"; then
    return 0
  fi

  file_paths+=("$path")
  file_statuses+=("$status")
  file_keys+=("$path")
}

refresh_file_index() {
  local previous_selected_key="$selected_key"
  local status_line=""
  local status=""
  local path=""

  file_paths=()
  file_statuses=()
  file_keys=()

  while IFS= read -r status_line; do
    [ -n "$status_line" ] || continue
    status="${status_line:0:2}"
    path="${status_line:3}"
    case "$path" in
      *' -> '* )
        path="${path##* -> }"
        ;;
    esac
    append_file_if_new "$status" "$path"
  done <<< "$repo_status_text"

  selected_row=0
  selected_key="__all__"
  if [ "$previous_selected_key" = "__all__" ]; then
    status_window_top=0
    return 0
  fi
  for file_index in "${!file_keys[@]}"; do
    if [ "${file_keys[$file_index]}" = "$previous_selected_key" ]; then
      selected_row=$((file_index + 1))
      selected_key="$previous_selected_key"
      break
    fi
  done
  [ "$selected_row" -gt 0 ] || status_window_top=0
}

refresh_state() {
  local status_exit=0
  local conflict_count=0
  local operation=""

  repo_error=""
  if ! copy_index; then
    repo_error="unable to copy the Git index"
    repo_status_text=""
    repo_operation="$(detect_operation)"
    refresh_file_index
    diff_dirty=1
    return 0
  fi

  repo_status_text="$(repo_status 2>&1)" || status_exit=$?
  operation="$(detect_operation)"
  conflict_count="$(count_conflicts "$repo_status_text")"

  if [ "$status_exit" -ne 0 ]; then
    repo_error="$repo_status_text"
    repo_operation="$operation"
  elif [ "$conflict_count" -gt 0 ]; then
    repo_operation="$operation, $conflict_count conflict(s)"
  else
    repo_operation="$operation"
  fi

  git_temp add -N . >/dev/null 2>&1 || true
  refresh_file_index
  diff_dirty=1
}

move_file_selection() {
  local direction="$1"
  local row_count=$((${#file_paths[@]} + 1))

  if [ "$direction" = "next" ]; then
    selected_row=$((selected_row + 1))
    if [ "$selected_row" -ge "$row_count" ]; then
      selected_row=0
    fi
  else
    selected_row=$((selected_row - 1))
    if [ "$selected_row" -lt 0 ]; then
      selected_row=$((row_count - 1))
    fi
  fi
  if [ "$selected_row" -eq 0 ]; then
    selected_key="__all__"
    status_window_top=0
  else
    selected_key="${file_keys[$((selected_row - 1))]}"
  fi
  diff_viewport_top=0
  diff_dirty=1
}

toggle_status_filter() {
  local filter="$1"

  case "$filter" in
    untracked)
      if [ "$show_untracked" = "on" ]; then show_untracked="off"; else show_untracked="on"; fi
      ;;
    added)
      if [ "$show_added" = "on" ]; then show_added="off"; else show_added="on"; fi
      ;;
    modified)
      if [ "$show_modified" = "on" ]; then show_modified="off"; else show_modified="on"; fi
      ;;
  esac
  refresh_file_index
  diff_viewport_top=0
  diff_dirty=1
}

pill() {
  local fg="$1"
  local bg="$2"
  local text="$3"

  printf '\033[38;5;%sm\033[38;5;%s;48;5;%sm %s \033[0m\033[38;5;%sm\033[0m' \
    "$bg" "$fg" "$bg" "$text" "$bg"
}

key_hint() {
  local key="$1"
  local label="$2"

  printf '\033[38;5;244m[\033[38;5;255m%s\033[38;5;244m] \033[0m\033[38;5;252m%s\033[0m' \
    "$key" "$label"
}

diff_append_multiline() {
  local output="$1"
  local line=""

  [ -n "$output" ] || return 0
  while IFS= read -r line; do
    diff_lines+=("$line")
  done <<< "$output"
}

screen_append_section() {
  local fg="$1"
  local bg="$2"
  local label="$3"

  screen_lines+=("")
  screen_lines+=("$(pill "$fg" "$bg" "$label")")
}

screen_append_status_section() {
  local header=""

  header="$(pill 15 39 "STATUS")  $(key_hint 'u' "?? $show_untracked")"
  header="$header  $(key_hint 'a' "A $show_added")"
  header="$header  $(key_hint 'm' "M $show_modified")"
  screen_lines+=("")
  screen_lines+=("$header")
}

screen_append_status_row() {
  local row_index="$1"
  local status="$2"
  local label="$3"
  local marker=" "
  local status_color=252
  local file_color=252
  local staged_label=""

  if [ "$row_index" -eq "$selected_row" ]; then
    marker='>'
  fi
  if [ "$status" = "  " ]; then
    screen_click_rows+=("${#screen_lines[@]}:$row_index")
    screen_lines+=("$(printf '\033[38;5;111m%s\033[0m \033[38;5;252m%s\033[0m' \
      "$marker" "$label")")
    return 0
  fi
  case "${status:0:1}" in
    A|M|D|R|C|T)
      status_color=40
      file_color=40
      staged_label=" (staged)"
      ;;
    *)
      if [ "$status" = "??" ] || [ "${status:1:1}" != " " ]; then
        status_color=196
        file_color=196
      fi
      ;;
  esac
  screen_click_rows+=("${#screen_lines[@]}:$row_index")
  screen_lines+=("$(printf '\033[38;5;111m%s\033[0m \033[38;5;%sm%s\033[0m \033[38;5;%sm%s%s\033[0m' \
    "$marker" "$status_color" "$status" "$file_color" "$label" "$staged_label")")
}

render_diff_text() {
  local kind="$2"
  local path="${1:-}"

  if [ -n "$path" ]; then
    if [ "$kind" = "staged" ]; then
      git_temp --no-pager diff --color=always --staged "${context_args[@]}" -- "$path" 2>/dev/null | \
        delta "${delta_args[@]}" || true
    else
      git_temp --no-pager diff --color=always "${context_args[@]}" -- "$path" 2>/dev/null | \
        delta "${delta_args[@]}" || true
    fi
  elif [ "${#file_paths[@]}" -gt 0 ] && \
    { [ -n "$search_term" ] || status_filters_active; }; then
    if [ "$kind" = "staged" ]; then
      git_temp --no-pager diff --color=always --staged "${context_args[@]}" -- "${file_paths[@]}" 2>/dev/null | \
        delta "${delta_args[@]}" || true
    else
      git_temp --no-pager diff --color=always "${context_args[@]}" -- "${file_paths[@]}" 2>/dev/null | \
        delta "${delta_args[@]}" || true
    fi
  elif [ "$kind" = "staged" ]; then
    repo_diff diff --color=always --staged "${context_args[@]}" 2>/dev/null | \
      delta "${delta_args[@]}" || true
  else
    repo_diff diff --color=always "${context_args[@]}" 2>/dev/null | \
      delta "${delta_args[@]}" || true
  fi
}

refresh_diff_lines() {
  local diff_output=""
  local file_index=0
  local path=""
  local status=""
  local index_state=""
  local worktree_state=""

  [ "$diff_dirty" -eq 1 ] || return 0
  diff_lines=()
  if [ -n "$repo_error" ]; then
    diff_lines+=($'\033[38;5;196m'"$repo_error"$'\033[0m')
  elif [ "${#file_paths[@]}" -eq 0 ]; then
    if [ -n "$repo_status_text" ]; then
      diff_lines+=("(no changes match the active filters)")
    else
      diff_lines+=("(clean)")
    fi
  elif [ "$selected_row" -eq 0 ]; then
    diff_output="$(render_diff_text "" staged)" || diff_output=""
    if [ -n "$diff_output" ]; then
      diff_lines+=($'\033[38;5;244mSTAGED\033[0m')
      diff_append_multiline "$diff_output"
    fi
    diff_output="$(render_diff_text "" unstaged)" || diff_output=""
    if [ -n "$diff_output" ]; then
      [ "${#diff_lines[@]}" -eq 0 ] || diff_lines+=("")
      diff_lines+=($'\033[38;5;244mUNSTAGED + UNTRACKED\033[0m')
      diff_append_multiline "$diff_output"
    fi
  else
    file_index=$((selected_row - 1))
    path="${file_paths[$file_index]}"
    status="${file_statuses[$file_index]}"
    index_state="${status:0:1}"
    worktree_state="${status:1:1}"
    if [ "$index_state" != " " ] && [ "$index_state" != "?" ]; then
      diff_output="$(render_diff_text "$path" staged)" || diff_output=""
      if [ -n "$diff_output" ]; then
        diff_lines+=($'\033[38;5;244mSTAGED\033[0m')
        diff_append_multiline "$diff_output"
      fi
    fi
    if [ "$worktree_state" != " " ] || [ "$status" = "??" ]; then
      diff_output="$(render_diff_text "$path" unstaged)" || diff_output=""
      if [ -n "$diff_output" ]; then
        [ "${#diff_lines[@]}" -eq 0 ] || diff_lines+=("")
        diff_lines+=($'\033[38;5;244mUNSTAGED + UNTRACKED\033[0m')
        diff_append_multiline "$diff_output"
      fi
    fi
  fi
  [ "${#diff_lines[@]}" -gt 0 ] || diff_lines+=("(no diff output)")
  diff_dirty=0
}

draw_screen() {
  local pinned_count="${#screen_lines[@]}"
  local diff_height=$((terminal_rows - pinned_count))
  local max_viewport=0
  local screen_row=0
  local line=""

  [ "$diff_height" -gt 0 ] || diff_height=1
  diff_page_size="$diff_height"
  if [ "${#diff_lines[@]}" -gt "$diff_height" ]; then
    max_viewport=$((${#diff_lines[@]} - diff_height))
  fi
  if [ "$diff_viewport_top" -lt 0 ]; then
    diff_viewport_top=0
  elif [ "$diff_viewport_top" -gt "$max_viewport" ]; then
    diff_viewport_top="$max_viewport"
  fi

  printf '\033[H\033[2J'
  for ((screen_row = 0; screen_row < terminal_rows; screen_row++)); do
    line=""
    if [ "$screen_row" -lt "$pinned_count" ]; then
      line="${screen_lines[$screen_row]}"
      printf '\033[%s;1H%s\033[K' "$((screen_row + 1))" "$line"
    elif [ $((diff_viewport_top + screen_row - pinned_count)) -lt "${#diff_lines[@]}" ]; then
      line="${diff_lines[$((diff_viewport_top + screen_row - pinned_count))]}"
      printf '\033[%s;1H\033[48;5;234m%s\033[0;48;5;234m\033[K\033[0m' \
        "$((screen_row + 1))" "$line"
    else
      printf '\033[%s;1H\033[48;5;234m\033[K\033[0m' "$((screen_row + 1))"
    fi
  done
  printf '\033[%s;1H' "$terminal_rows"
}

render() {
  local file_index=0
  local file_capacity=0
  local file_end=0
  local max_window_top=0
  local status_capacity=0
  local controls=""
  local title_line=""

  terminal_rows="$(terminal_row_count)"
  context_args=(-U"$context_lines")
  delta_args=(
    --paging=never
    --plus-style="syntax 22"
    --plus-emph-style="syntax 28"
    --plus-empty-line-marker-style="normal 22"
    --minus-style="normal 52"
    --minus-emph-style="normal 124"
    --minus-empty-line-marker-style="normal 52"
  )
  if [ "$show_line_numbers" = "on" ]; then
    delta_args+=(--line-numbers)
  fi
  if [ "$mode" = "sbs" ]; then
    delta_args+=(--side-by-side)
  fi

  screen_lines=()
  screen_click_rows=()
  case "$mode" in
    sbs) mode_label="sbs" ;;
    *) mode_label="inline" ;;
  esac

  title_line="$(pill 15 39 ' 👀 diffy-watch')  $(pill 15 60 "$mode_label")"
  title_line="$title_line  $(printf '\033[38;5;111m%s\033[0m  \033[38;5;246m%s\033[0m' "$(date '+%Y-%m-%d %H:%M:%S')" "$repo_root")"
  screen_lines+=("$title_line")
  controls="$(
    printf '\033[38;5;244mControls\033[0m  '
    key_hint 'r' 'refresh'
    printf '  '
    key_hint 's/i' 'diff mode'
    printf '  '
    key_hint 'n' 'line nums'
    printf '  '
    key_hint '/' 'search'
    printf '  '
    key_hint '+/-' 'context'
    printf '  '
    key_hint '↑/↓' 'page diff'
    printf '  '
    key_hint '←/→' 'select'
    printf '  '
    key_hint 'mouse' 'select/scroll'
    printf '  '
    key_hint 'q' 'quit'
    printf '  '
    key_hint 'l' 'lazygit'
  )"
  screen_lines+=("$controls")
  screen_lines+=($'\033[38;5;244mContext\033[0m   \033[38;5;255m'"$context_lines lines"$'\033[0m')
  if [ -n "$search_term" ]; then
    screen_lines+=($'\033[38;5;244mSearch\033[0m    \033[38;5;255m'"$search_term"$'\033[0m')
  fi
  screen_lines+=($'\033[38;5;244mOperation\033[0m  '"$repo_operation")
  if [ -n "$repo_error" ]; then
    screen_lines+=($'\033[38;5;196mGit error\033[0m   '"$repo_error")
  fi

  screen_append_status_section
  screen_append_status_row 0 "  " "All diffs"
  status_capacity=$((terminal_rows / 3))
  [ "$status_capacity" -ge 2 ] || status_capacity=2
  file_capacity=$((status_capacity - 1))
  if [ "$selected_row" -gt 0 ]; then
    file_index=$((selected_row - 1))
    if [ "$file_index" -lt "$status_window_top" ]; then
      status_window_top="$file_index"
    elif [ "$file_index" -ge $((status_window_top + file_capacity)) ]; then
      status_window_top=$((file_index - file_capacity + 1))
    fi
  fi
  max_window_top=$((${#file_paths[@]} - file_capacity))
  [ "$max_window_top" -ge 0 ] || max_window_top=0
  [ "$status_window_top" -le "$max_window_top" ] || status_window_top="$max_window_top"
  file_end=$((status_window_top + file_capacity))
  [ "$file_end" -le "${#file_paths[@]}" ] || file_end="${#file_paths[@]}"
  for ((file_index = status_window_top; file_index < file_end; file_index++)); do
    screen_append_status_row "$((file_index + 1))" "${file_statuses[$file_index]}" "${file_paths[$file_index]}"
  done

  refresh_diff_lines
  screen_append_section 15 28 "DIFFS"
  draw_screen
}

launch_lazygit() {
  leave_tui
  if ! command -v lazygit >/dev/null 2>&1; then
    printf 'diffy-watch: lazygit is not installed\n' >&2
    enter_tui
    return 0
  fi
  (
    cd "$repo_root"
    command lazygit
  )
  enter_tui
  diff_viewport_top=0
  diff_dirty=1
}

select_status_at_row() {
  local mouse_y="$1"
  local logical_row=$((mouse_y - 1))
  local entry=""
  local entry_row=""
  local row_index=""

  if [ "${#screen_click_rows[@]}" -gt 0 ]; then
    for entry in "${screen_click_rows[@]}"; do
      entry_row="${entry%%:*}"
      row_index="${entry#*:}"
      if [ "$entry_row" -eq "$logical_row" ]; then
        selected_row="$row_index"
        if [ "$selected_row" -eq 0 ]; then
          selected_key="__all__"
          status_window_top=0
        else
          selected_key="${file_keys[$((selected_row - 1))]}"
        fi
        diff_viewport_top=0
        diff_dirty=1
        force_render=1
        return 0
      fi
    done
  fi
}

page_diff() {
  local direction="$1"
  local amount=$((diff_page_size - 1))

  [ "$amount" -gt 0 ] || amount=1
  if [ "$direction" = "next" ]; then
    diff_viewport_top=$((diff_viewport_top + amount))
  else
    diff_viewport_top=$((diff_viewport_top - amount))
    [ "$diff_viewport_top" -ge 0 ] || diff_viewport_top=0
  fi
  force_render=1
}

handle_mouse_event() {
  local payload="$1"
  local coordinates=""
  local button=""
  local mouse_x=""
  local mouse_y=""
  local action=""
  local remainder=""

  case "$payload" in
    *M)
      action="M"
      coordinates="${payload%M}"
      ;;
    *m)
      action="m"
      coordinates="${payload%m}"
      ;;
    *)
      return 0
      ;;
  esac

  button="${coordinates%%;*}"
  remainder="${coordinates#*;}"
  mouse_x="${remainder%%;*}"
  mouse_y="${remainder#*;}"
  [ -n "$mouse_x" ] || return 0
  [ -n "$mouse_y" ] || return 0

  case "$button" in
    0)
      if [ "$action" = "M" ]; then
        select_status_at_row "$mouse_y"
      fi
      ;;
    64)
      if [ "$action" = "M" ]; then
        page_diff previous
      fi
      ;;
    65)
      if [ "$action" = "M" ]; then
        page_diff next
      fi
      ;;
  esac
}

consume_escape_sequence() {
  local byte=""
  local payload=""

  IFS= read -rsn1 -t 1 byte || return 0
  [ "$byte" = "[" ] || return 0
  IFS= read -rsn1 -t 1 byte || return 0
  if [ "$byte" = "<" ]; then
    while IFS= read -rsn1 -t 1 byte; do
      payload="$payload$byte"
      case "$byte" in
        [mM])
          handle_mouse_event "$payload"
          return 0
          ;;
      esac
    done
    return 0
  fi

  case "$byte" in
    A)
      page_diff previous
      return 0
      ;;
    B)
      page_diff next
      return 0
      ;;
    C)
      move_file_selection next
      force_render=1
      return 0
      ;;
    D)
      move_file_selection previous
      force_render=1
      return 0
      ;;
  esac

  while :; do
    case "$byte" in
      [A-Za-z~])
        return 0
        ;;
    esac
    IFS= read -rsn1 -t 1 byte || return 0
  done
}

prompt_search() {
  local input=""
  local rows=""

  rows="$(terminal_row_count)"
  if [ -n "$terminal_stty_state" ]; then
    stty "$terminal_stty_state" 2>/dev/null || true
  fi
  printf '\033[?25h\033[%s;1H\033[2Ksearch (blank clears): ' "$rows"
  if ! IFS= read -r input; then
    if [ -n "$terminal_stty_state" ]; then
      stty -echo 2>/dev/null || true
    fi
    printf '\033[?25l'
    return 1
  fi
  if [ -n "$terminal_stty_state" ]; then
    stty -echo 2>/dev/null || true
  fi
  printf '\033[?25l'
  search_term="$input"
}

compute_repo_signature() {
  local status_text=""
  local status_line=""
  local path=""
  local index_path=""

  status_text="$(repo_status_actual 2>&1)" || true
  index_path="$(git_path index 2>/dev/null)" || index_path=""
  {
    printf '%s\n' "$status_text"
    if [ -n "$index_path" ] && [ -f "$index_path" ]; then
      git hash-object "$index_path" 2>/dev/null || true
    fi
    while IFS= read -r status_line; do
      [ -n "$status_line" ] || continue
      path="${status_line:3}"
      case "$path" in
        *' -> '* )
          path="${path##* -> }"
          ;;
      esac
      if [ -e "$repo_root/$path" ] || [ -L "$repo_root/$path" ]; then
        git hash-object "$repo_root/$path" 2>/dev/null || true
      else
        printf 'missing:%s\n' "$path"
      fi
    done <<< "$status_text"
    detect_operation
  } | git hash-object --stdin
}

last_signature=""
resize_pending=0
force_render=1

trap 'resize_pending=1' WINCH
enter_tui
refresh_state
last_signature="$(compute_repo_signature)"
render
force_render=0

while true; do
  key=""
  if [ "$resize_pending" -eq 1 ]; then
    resize_pending=0
    restore_tmux_focus
    diff_dirty=1
    render
  fi

  if IFS= read -rsn1 -t "$interval" key; then
    if [ "$key" = $'\e' ]; then
      consume_escape_sequence
      if [ "$force_render" -eq 1 ]; then
        render
        force_render=0
      fi
      continue
    fi
    case "$key" in
      q)
        exit 0
        ;;
      r)
        refresh_state
        last_signature="$(compute_repo_signature)"
        force_render=1
        ;;
      s)
        if [ "$mode" = "sbs" ]; then
          mode="inline"
        else
          mode="sbs"
        fi
        diff_viewport_top=0
        diff_dirty=1
        force_render=1
        ;;
      i)
        if [ "$mode" = "inline" ]; then
          mode="sbs"
        else
          mode="inline"
        fi
        diff_viewport_top=0
        diff_dirty=1
        force_render=1
        ;;
      n)
        if [ "$show_line_numbers" = "on" ]; then
          show_line_numbers="off"
        else
          show_line_numbers="on"
        fi
        diff_viewport_top=0
        diff_dirty=1
        force_render=1
        ;;
      /)
        if prompt_search; then
          refresh_file_index
          diff_viewport_top=0
          diff_dirty=1
          force_render=1
        fi
        ;;
      c)
        search_term=""
        refresh_file_index
        diff_viewport_top=0
        diff_dirty=1
        force_render=1
        ;;
      u)
        toggle_status_filter untracked
        force_render=1
        ;;
      a)
        toggle_status_filter added
        force_render=1
        ;;
      m)
        toggle_status_filter modified
        force_render=1
        ;;
      +|=)
        context_lines=$((context_lines + 1))
        diff_viewport_top=0
        diff_dirty=1
        force_render=1
        ;;
      -)
        if [ "$context_lines" -gt 0 ]; then
          context_lines=$((context_lines - 1))
        fi
        diff_viewport_top=0
        diff_dirty=1
        force_render=1
        ;;
      j)
        move_file_selection next
        force_render=1
        ;;
      k)
        move_file_selection previous
        force_render=1
        ;;
      l)
        launch_lazygit
        refresh_state
        last_signature="$(compute_repo_signature)"
        force_render=1
        ;;
    esac
    if [ "$force_render" -eq 1 ]; then
      render
      force_render=0
    fi
    continue
  fi

  signature="$(compute_repo_signature)"
  if [ "$signature" != "$last_signature" ]; then
    refresh_state
    last_signature="$signature"
    render
  fi
done
